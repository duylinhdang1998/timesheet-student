VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Public URL of the web app (Vercel). The Android/iOS app uses it for invite links,
# since its own origin is https://localhost. Leave empty to share only the invite code.
VITE_PUBLIC_URL=https://<your-app>.vercel.app
